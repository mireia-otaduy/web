rules_version = '2';

// ============================================================================
// REGLAS DE SEGURIDAD DE FIRESTORE · LCC Manufacturing
//
// Colección "solicitudes": recibe las solicitudes de presupuesto del formulario web.
//   - Cualquier visitante puede CREAR una solicitud, pero solo si cumple el formato
//     exacto que se valida abajo (campos permitidos, tipos y longitudes).
//   - Nadie puede LEER, MODIFICAR ni BORRAR documentos desde un navegador. Las
//     solicitudes se consultan en la consola de Firebase (o con el SDK de administración).
//   - Todo lo demás está denegado.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /solicitudes/{requestId} {
      allow create: if isValidRequest(request.resource.data);
      allow read, update, delete: if false;
    }

    // Denegar cualquier otra colección
    match /{document=**} {
      allow read, write: if false;
    }

    // Cadena con longitud entre min y max
    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isValidRequest(data) {
      return data.keys().hasOnly([
               'name', 'company', 'email', 'phone', 'technology', 'projectType',
               'pieces', 'date', 'message', 'services', 'lang', 'page', 'createdAt'
             ])
          && data.keys().hasAll(['name', 'company', 'email', 'message', 'lang', 'createdAt'])
          && isText(data.name, 1, 120)
          && isText(data.company, 1, 120)
          && isText(data.email, 5, 160)
          && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$')
          && isText(data.message, 10, 3000)
          && data.lang in ['es', 'en', 'zh']
          && data.createdAt is timestamp
          && data.createdAt > request.time - duration.value(1, 'd')
          && data.createdAt < request.time + duration.value(1, 'd')
          && (!('phone' in data) || isText(data.phone, 6, 40))
          && (!('technology' in data) || data.technology in ['stamping', 'forging', 'tube', 'machining', 'wire', 'welding', 'molds', 'other'])
          && (!('projectType' in data) || data.projectType in ['prototype', 'short-run', 'long-run'])
          && (!('pieces' in data) || (data.pieces is int && data.pieces >= 1 && data.pieces <= 100000000))
          && (!('date' in data) || isText(data.date, 10, 10))
          && (!('services' in data) || (data.services is list && data.services.size() <= 3))
          && (!('page' in data) || isText(data.page, 1, 200));
    }
  }
}
